{
  "manifest_version": 3,
  "name": "CaptionShift",
  "version": "1.0.0",
  "description": "Traduce los subtítulos de Netflix en tiempo real usando la Translator API nativa de Chrome (on-device, sin servidores).",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*.netflix.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
